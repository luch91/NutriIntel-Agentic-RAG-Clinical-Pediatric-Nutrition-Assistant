{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb",
        "runtime": "python3.11"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/metrics",
      "dest": "/api/index.py"
    }
  ],
  "env": {
    "REDIS_URL": "@redis_url",
    "QDRANT_URL": "@qdrant_url",
    "QDRANT_COLLECTION": "@qdrant_collection",
    "EVAL_SECRET": "@eval_secret"
  }
}

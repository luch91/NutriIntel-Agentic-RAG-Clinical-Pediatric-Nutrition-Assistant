# CPNA v1 — Environment Variables
# Copy this file to .env and fill in your values. Never commit .env.

# ── FastAPI / Uvicorn ──────────────────────────────────────────────────────
PORT=8000

# ── Redis (state persistence) ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Qdrant (vector store) ─────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=cpna_passages

# ── Eval platform integration ─────────────────────────────────────────────
# Shared secret between the CPNA backend and the eval platform.
# Leave blank to disable auth (development only).
EVAL_SECRET=

# ── Frontend ──────────────────────────────────────────────────────────────
# URL of the CPNA FastAPI backend, as seen by the Next.js frontend.
NEXT_PUBLIC_API_URL=http://localhost:8000

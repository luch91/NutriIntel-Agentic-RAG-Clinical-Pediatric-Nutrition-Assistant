# CPNA v1 — Environment Variables
# Copy this file to .env and fill in your values. Never commit .env.

# ── FastAPI / Uvicorn ──────────────────────────────────────────────────────
PORT=8000

# ── Redis (state persistence) ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Qdrant (vector store) ─────────────────────────────────────────────────
# Local dev: leave both blank — uses in-memory Qdrant, re-ingests PDFs on startup.
# Production (Vercel): set both to your Qdrant Cloud cluster credentials.
#   Sign up free at https://cloud.qdrant.io — create a cluster, copy URL + API key.
#   Then run once: rag_env\Scripts\python.exe scripts/build_cloud_index.py
QDRANT_URL=
QDRANT_API_KEY=

# ── Eval platform integration ─────────────────────────────────────────────
# Shared secret between the CPNA backend and the eval platform.
# Leave blank to disable auth (development only).
EVAL_SECRET=

# ── Frontend ──────────────────────────────────────────────────────────────
# URL of the CPNA FastAPI backend, as seen by the Next.js frontend.
NEXT_PUBLIC_API_URL=http://localhost:8000
